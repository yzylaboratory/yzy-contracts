# Copy to auth.env on the Y02/H02 host (mode 0600, never commit).
# Dedicated isolated GoTrue v2.197.0 for DEV only (completely separate from PROD Auth).
# Generate GOTRUE_JWT_SECRET and GOTRUE_JWT_KEYS with: python3 scripts/generate-dev-auth-keys.py

GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
API_EXTERNAL_URL=https://yzycontracts.yzylabs.dev/auth/v1

GOTRUE_DB_DRIVER=postgres
DB_NAMESPACE=auth
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:__CHANGE_ME_DEV_POSTGRES_PASSWORD__@db:5432/postgres

GOTRUE_SITE_URL=https://yzycontracts.yzylabs.dev
GOTRUE_URI_ALLOW_LIST=https://yzycontracts.yzylabs.dev/**

# ES256 asymmetric JWK array (required by Rust API JWKS verifier) + fallback HS256 secret.
GOTRUE_JWT_SECRET=__CHANGE_ME_GENERATE_WITH_SCRIPT__
GOTRUE_JWT_KEYS=__CHANGE_ME_GENERATE_WITH_SCRIPT__
GOTRUE_JWT_ISSUER=https://yzycontracts.yzylabs.dev/auth/v1
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_EXP=3600

# DEV Policy: invite-only / admin-provisioned accounts, no open signup, no real outbound email.
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_MAILER_AUTOCONFIRM=true
