server {
    listen 8080;
    server_tokens off;
    resolver 127.0.0.11 valid=15s ipv6=off;

    location = /auth/v1/.well-known/jwks.json {
        allow ${DEV_PEER_IP};
        deny all;
        limit_except GET { deny all; }
        set $upstream http://yzylabs-supabase-kong:8000;
        proxy_pass $upstream;
    }

    location / {
        return 404;
    }
}
