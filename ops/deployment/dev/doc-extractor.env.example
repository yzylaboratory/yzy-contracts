# Copy to doc-extractor.env on the Y02/H02 host (mode 0600, never commit).
APP_ENV=development
# Must match EXTRACTOR_API_TOKEN in api.env.
INTERNAL_API_KEY=__CHANGE_ME_DEV_EXTRACTOR_TOKEN__
# Exact hostname of the dedicated DEV R2 endpoint (never PROD).
R2_ALLOWED_HOSTS=__DEV_CF_ACCOUNT_ID__.r2.cloudflarestorage.com
MAX_FILE_SIZE_MB=25
MAX_CONCURRENT_EXTRACTIONS=2
EXTRACTION_TIMEOUT_SECONDS=300
