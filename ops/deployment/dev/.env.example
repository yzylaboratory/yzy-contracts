# Copy to .env on the Y02/H02 host (mode 0600, never commit).
# deploy-contracts-dev.sh updates CONTRACTS_API_IMAGE and CONTRACTS_PORTAL_IMAGE.
CONTRACTS_API_IMAGE=ghcr.io/yzylaboratory/yzy-contracts-api:dev-sha-0000000
CONTRACTS_PORTAL_IMAGE=ghcr.io/yzylaboratory/yzy-contracts-portal:dev-sha-0000000

# Prebuilt or loaded helper images for PDF rendering and document extraction.
CONTRACTS_RENDERER_IMAGE=yzy-contracts-renderer:20261110-r17
CONTRACTS_EXTRACTOR_IMAGE=yzylabs/doc-extractor-api:0.1.0

# Loopback port for deploy health checks.
DEV_EDGE_BIND_PORT=8850

# Internal SeaweedFS serves signed object requests through the DEV edge.
COMPOSE_PROFILES=local-s3
DEV_TUNNEL_NETWORK=yzy-automation_default
