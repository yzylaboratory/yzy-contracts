# Copy to api.env on the Y02/H02 host (mode 0600, never commit).
# Runtime role connects as yzy_contracts_dev_app (schema yzy_contracts_dev, built via CONTRACTS_BUILD_ENV=development).

RUST_LOG=info,yzy_contracts_api=info,tower_http=info
HTTP_BIND_ADDR=0.0.0.0:8080

DATABASE_URL=postgres://yzy_contracts_dev_app:__CHANGE_ME_DEV_APP_ROLE_PASSWORD__@db:5432/postgres
DATABASE_MAX_CONNECTIONS=10

# Internal JWKS fetch over Docker network avoids public Cloudflare roundtrip / bot challenges.
# SUPABASE_JWT_ISSUER must still match the external "iss" claim emitted by GoTrue.
SUPABASE_JWKS_URL=http://auth:9999/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://yzycontracts.yzylabs.dev/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

CORS_ALLOWED_ORIGINS=https://yzycontracts.yzylabs.dev

# Dedicated DEV R2 bucket (NEVER point to the PROD bucket).
# If using local-s3 profile instead, set R2_ENDPOINT=http://storage:9000 and R2_FORCE_PATH_STYLE=true.
R2_ENDPOINT=https://__DEV_CF_ACCOUNT_ID__.r2.cloudflarestorage.com
R2_BUCKET=yzy-contracts-dev
R2_ACCESS_KEY_ID=__CHANGE_ME_DEV_R2_ACCESS_KEY_ID__
R2_SECRET_ACCESS_KEY=__CHANGE_ME_DEV_R2_SECRET_ACCESS_KEY__
R2_FORCE_PATH_STYLE=false

UPLOAD_MAX_BYTES=26214400
PRESIGN_UPLOAD_TTL_SECS=600
PRESIGN_DOWNLOAD_TTL_SECS=300
TEMPLATE_MAX_BYTES=5242880

EXTRACTOR_URL=http://doc-extractor:8000
EXTRACTOR_API_TOKEN=__CHANGE_ME_DEV_EXTRACTOR_TOKEN__
EXTRACTOR_TIMEOUT_SECS=600

DOCUMENT_RENDERER_URL=http://renderer:8080
DOCUMENT_RENDERER_API_TOKEN=__CHANGE_ME_DEV_RENDERER_TOKEN__

CONVERSION_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECS=2
REQUEST_TIMEOUT_SECS=30

# DEV Policy: no real emails (omit YZY_NOTIFICATIONS_URL / YZY_NOTIFICATIONS_TOKEN / BILLING_PORTAL_URL)
# and no real billing transfer accounts (omit CONTRACTS_BILLING_*).
# Optional synthetic/DEV-only OpenRouter key for POST /api/v1/document-readings:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.8-flash
# OPENROUTER_TIMEOUT_SECS=90
