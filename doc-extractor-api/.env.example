APP_NAME=Doc Extractor API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

INTERNAL_API_KEY=change-me-in-production-at-least-32-chars

MAX_FILE_SIZE_MB=25
MAX_CONCURRENT_EXTRACTIONS=2
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
DOWNLOAD_TIMEOUT_SECONDS=60
EXTRACTION_TIMEOUT_SECONDS=300

OCR_ENABLED=true
OCR_LANGUAGES=es,en
OCR_ENGINE=auto

R2_ALLOWED_HOSTS=example.r2.cloudflarestorage.com
DOCLING_ARTIFACTS_PATH=

LOG_LEVEL=INFO
ENABLE_API_DOCS=true
