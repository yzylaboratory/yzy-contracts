    {
      "name": "3. Extracción Documental (R2 Presigned URLs)",
      "item": [
        {
          "name": "POST /internal/v1/extract — PDF Digital (Auto OCR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Extracción completada con estructura válida (200 OK)', function () {",
                  "        pm.expect(body.status).to.eql('completed');",
                  "        pm.expect(body.job_id).to.eql('ae17c335-55bc-401a-a46a-391dc7b54d8b');",
                  "        pm.expect(body.document.filename).to.eql('contrato_servicios.pdf');",
                  "        pm.expect(body.extraction.markdown).to.be.a('string').and.not.be.empty;",
                  "        pm.expect(body.extraction.metadata.duration_ms).to.be.a('number').and.be.at.least(0);",
                  "        pm.expect(body.extraction.warnings).to.be.an('array');",
                  "    });",
                  "} else {",
                  "    pm.test('Si la URL prefirmada de ejemplo expiró o no está firmada, devuelve ErrorResponse controlado', function () {",
                  "        pm.expect([400, 403, 404, 410, 502]).to.include(pm.response.code);",
                  "        pm.expect(body).to.have.property('error');",
                  "        pm.expect(body.error.code).to.be.oneOf(['STORAGE_ACCESS_DENIED', 'PRESIGNED_URL_EXPIRED', 'DOCUMENT_NOT_FOUND', 'DOWNLOAD_FAILED']);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-API-Key",
                "value": "{{internal_api_key}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"ae17c335-55bc-401a-a46a-391dc7b54d8b\",\n  \"document\": {\n    \"filename\": \"contrato_servicios.pdf\",\n    \"content_type\": \"application/pdf\",\n    \"download_url\": \"{{presigned_pdf_url}}\"\n  },\n  \"options\": {\n    \"ocr_mode\": \"auto\",\n    \"ocr_languages\": [\"es\", \"en\"],\n    \"extract_tables\": true\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/v1/extract",
              "host": ["{{base_url}}"],
              "path": ["internal", "v1", "extract"]
            },
            "description": "Extrae Markdown estructurado y metadatos desde un PDF alojado en Cloudflare R2 mediante URL prefirmada (`{{presigned_pdf_url}}`)."
          },
          "response": []
        },
