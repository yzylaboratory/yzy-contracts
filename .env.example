# Copy to .env for local development. Every value is required: the services stop
# at startup when one is missing. Values below are local placeholders, not secrets.

RUST_LOG=info,yzy_contracts_api=info,tower_http=info

# --- Local stack only (docker-compose.yml) ---------------------------------
LOCAL_POSTGRES_PASSWORD=change-me-local-postgres
LOCAL_APP_ROLE_PASSWORD=change-me-local-app-role
LOCAL_S3_ACCESS_KEY=local-access-key
LOCAL_S3_SECRET_KEY=change-me-local-secret-key
LOCAL_GOTRUE_JWT_SECRET=change-me-local-gotrue-secret-with-32-characters
# ES256 signing key as a JSON array. Generate with: python3 scripts/generate_local_auth_key.py
LOCAL_GOTRUE_JWT_KEYS=

# --- API and worker ---------------------------------------------------------
HTTP_BIND_ADDR=127.0.0.1:8080

# Runtime role. It has no DDL rights. On the shared Supabase, connect through the
# pooler in session mode (port 5432) as yzy_contracts_app.<tenant>.
DATABASE_URL=postgres://yzy_contracts_app:change-me-local-app-role@127.0.0.1:54322/postgres
DATABASE_MAX_CONNECTIONS=10
# Owner role, used only by the "migrate" command.
MIGRATION_DATABASE_URL=postgres://postgres:change-me-local-postgres@127.0.0.1:54322/postgres

# Auth. The JWKS location and the issuer are independent settings: use the "iss"
# claim that real tokens carry, which can differ from the public URL.
SUPABASE_JWKS_URL=http://127.0.0.1:9999/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:9999
SUPABASE_JWT_AUDIENCE=authenticated
# UUID and confirmed email of the same administrator in this Auth environment.
CONTRACTS_SUPERADMIN_ID=
CONTRACTS_SUPERADMIN_EMAIL=

# Comma-separated explicit origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Transfer destination, required only when creating new billing accounts.
# Configure all four on the Rust API. Do not set NEXT_PUBLIC_* equivalents.
CONTRACTS_BILLING_BANK_NAME=
CONTRACTS_BILLING_ACCOUNT_HOLDER=
CONTRACTS_BILLING_ACCOUNT_TYPE=
CONTRACTS_BILLING_ACCOUNT_NUMBER=

# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com with R2_FORCE_PATH_STYLE=false.
# The local S3 service uses the values below.
R2_ENDPOINT=http://storage.localhost:9000
R2_BUCKET=yzy-contracts
R2_ACCESS_KEY_ID=local-access-key
R2_SECRET_ACCESS_KEY=change-me-local-secret-key
R2_FORCE_PATH_STYLE=true

UPLOAD_MAX_BYTES=26214400
PRESIGN_UPLOAD_TTL_SECS=600
PRESIGN_DOWNLOAD_TTL_SECS=300
TEMPLATE_MAX_BYTES=5242880

EXTRACTOR_URL=http://127.0.0.1:8000
# Shared with doc-extractor-api (its INTERNAL_API_KEY). Generate with: openssl rand -hex 32
EXTRACTOR_API_TOKEN=change-me-extractor-token
EXTRACTOR_TIMEOUT_SECS=600
# For an API process outside Compose, set both to reach a private renderer.
# DOCUMENT_RENDERER_URL=http://127.0.0.1:39087
# DOCUMENT_RENDERER_API_TOKEN=local-only-renderer-token-change-me

CONVERSION_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECS=2
REQUEST_TIMEOUT_SECS=30

# --- doc-extractor-api (see doc-extractor-api/README.md) -----------------------
# Hostname of the R2 endpoint. The extractor accepts nothing else, and refuses
# the local storage service, so conversions need real R2 settings above.
EXTRACTOR_R2_ALLOWED_HOSTS=example.r2.cloudflarestorage.com
# Keep aligned with UPLOAD_MAX_BYTES.
EXTRACTOR_MAX_FILE_SIZE_MB=25
EXTRACTOR_MAX_CONCURRENT_EXTRACTIONS=2
# Below EXTRACTOR_TIMEOUT_SECS, so the extractor answers before the API gives up.
EXTRACTOR_EXTRACTION_TIMEOUT_SECONDS=300
